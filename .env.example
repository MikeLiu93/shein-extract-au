# 复制为 .env（项目本地）或写入 %APPDATA%\shein-extract-au\config.env。
# .env 已 gitignore，不会被提交。

# ── Anthropic API key（用于 AI 生成 eBay 标题；不设则走规则 fallback）─────────
ANTHROPIC_API_KEY=sk-ant-...

# ── 输入 Excel 所在目录 ───────────────────────────────────────────────────────
SHEIN_SUBMITTED_DIR=D:\共享云端硬盘\02 希音\澳洲站

# ── 输入 Excel 文件名（可选；不设则自动处理目录下所有 .xlsx）─────────────────
# SHEIN_INPUT_FILENAME=Shein 澳洲站 Links.xlsx

# ── 输出根目录 ────────────────────────────────────────────────────────────────
SHEIN_OUTPUT_DIR=D:\共享云端硬盘\02 希音\澳洲站\上架资料-已完成

# ── 澳洲站运费（默认 AU$7.95，澳洲 Standard shipping）─────────────────────────
# SHEIN_AU_SHIPPING_FEE=7.95

# ── eBay 价格倍率（默认 2.0，eBay 价格 = Price × 2 + Shipping）────────────────
# SHEIN_EBAY_MARKUP=2.0
